# Secrets — never commit
.env
.env.local
.env.*.local
.kaggle/
*.pem
*.key

# Python artefacts
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# Data — contains PII / too large
data/raw/
data/processed/
*.csv
*.parquet
*.zip

# Model binaries — committed via models/ directory
*.h5
*.pt
*.onnx

# Logs
*.log

# PDFs / screenshots — not source code
*.pdf

# Node
node_modules/
frontend/build/
frontend/.env
frontend/.env.local
